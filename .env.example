# Variables de entorno del servidor
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=tu_jwt_secret_key_muy_segura_aqui_2024_cambiar_en_produccion
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration para Recuperación de Contraseñas
# ⚠️ IMPORTANTE: Configura estos valores para Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_password_de_aplicacion_de_gmail
EMAIL_FROM=no-reply@tudominio.com

# Instrucciones para configurar Gmail:
# 1. Ir a Google Account settings
# 2. Seguridad > Verificación en 2 pasos (debe estar activada)
# 3. Seguridad > Contraseñas de aplicaciones
# 4. Generar contraseña para "Correo electrónico"
# 5. Usar esa contraseña en EMAIL_PASS

# Security Configuration
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=300000

# File Paths para Persistencia
USERS_FILE=data/users.json
LOGS_FILE=data/logs.json
BLOCKED_ACCOUNTS_FILE=data/blocked_accounts.json
PASSWORD_RESETS_FILE=data/password_resets.json

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PASSWORD_RESET_LIMIT_MAX=5
PASSWORD_RESET_LIMIT_WINDOW_MS=3600000

# Token Configuration
RESET_TOKEN_EXPIRES_MINUTES=60
CLEANUP_INTERVAL_MINUTES=60
